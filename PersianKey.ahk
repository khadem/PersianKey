; Shift + space: ZERO WIDTH NON-JOINER (zwnj)
+Space:: {
    InputLocaleID := DllCall("GetKeyboardLayout", "UInt", ThreadID := DllCall("GetWindowThreadProcessId", "UInt",
        WinExist("A"), "UInt", 0), "UInt")
    if (InputLocaleID = 69796905) {
        Send "{U+200C}"
    }
}

